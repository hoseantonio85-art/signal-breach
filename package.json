{
  "name": "signal-breach",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:terminology && npm run check:card-layout && npm run check:audio-toggle && npm run test:engine && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check:terminology": "node scripts/check-ui-terminology.mjs",
    "check:card-layout": "node scripts/check-card-layout.mjs",
    "check:audio-toggle": "node scripts/check-audio-toggle.mjs",
    "test:engine": "node --experimental-strip-types --test tests/game-engine.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^1.65.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "overrides": {
    "rollup": "4.67.2"
  }
}
